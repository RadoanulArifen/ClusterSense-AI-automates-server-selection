# PostgreSQL connection; URL-encode special characters in the password.
DATABASE_URL=postgresql://clustersense:CHANGE_ME_DB_PASSWORD@localhost:5432/clustersense_db
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
# First-run administrator account. Used only when the users table is empty.
ADMIN_EMAIL=admin@example.com
# Set a unique password before starting; never distribute the actual value.
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
# Optional Gemini API key; blank uses the built-in fallback.
GEMINI_API_KEY=
# Comma-separated browser origins allowed to access the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
# Docker PostgreSQL initialization and healthcheck settings.
POSTGRES_USER=clustersense
POSTGRES_DB=clustersense_db
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
# Docker web port. Bind to localhost; put a TLS reverse proxy in front for public use.
WEB_PORT=8080
